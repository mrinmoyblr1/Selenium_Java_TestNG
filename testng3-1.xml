<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Loan Department" verbose="1">

    <!-- Optional: define group sets for reuse -->
    <groups>
        <define name="coreLoan">
            <include name="smoke"/>
            <include name="regression"/>
        </define>
    </groups>

    <!-- Run only smoke tests for Personal Loan (exclude any API tests) -->
    <test name="Personal Loan - Smoke">
        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="api"/>
            </run>
        </groups>
        <classes>
            <class name="TestNGTutorial.Day1"/>
            <class name="TestNGTutorial.Day2"/>
        </classes>
    </test>

    <!-- Run regression tests for Personal Loan -->
    <test name="Personal Loan - Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="TestNGTutorial.Day1"/>
            <class name="TestNGTutorial.Day2"/>
        </classes>
    </test>

    <!-- Run smoke + api tests for Car Loan, exclude web tests -->
    <test name="Car Loan - Smoke+API">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="api"/>
                <exclude name="web"/>
            </run>
        </groups>
        <classes>
            <class name="TestNGTutorial.Day3"/>
            <class name="TestNGTutorial.Day4"/>
        </classes>
    </test>

    <!-- Example: run only API tests across classes -->
    <test name="API Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="TestNGTutorial.Day3"/>
            <class name="TestNGTutorial.Day4"/>
        </classes>
    </test>

</suite>
